# Copy to .env (gitignored) and fill in. Variables already set in your shell win.
# Every setting and the order they are read in: ledgercheck connections --help

# Your OpenRouter key. Live calls also need LEDGERCHECK_LLM=1 in your shell
# (it is never read from this file).
OPENROUTER_API_KEY=your-openrouter-key-here

# Optional: settings can live here instead of connections.local.toml.
# LEDGERCHECK_LLM_PROVIDER=openrouter
# LEDGERCHECK_MODEL_LARGE=provider/model-id
# LEDGERCHECK_SPEND_CAP_USD=0.50

# Optional tracing (needs: pip install 'ledgercheck[langfuse]').
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here
